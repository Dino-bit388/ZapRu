@{
    ViewData["Title"] = "Стенды пользователей — ZAPRU";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/Market.css">
}
@section Header {
    <div class="market-header-container container">
        <a href="/Home/Index" class="logo">ZAPRU</a>
        <div class="market-header-buttons">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="header-user">
                    <div class="notification-icon" id="notificationIcon">
                        <i class="fas fa-bell"></i>
                        <span class="badge" id="notificationBadge" style="display: none;">0</span>
                        <div class="dropdown-menu" id="notificationDropdown">
                            <div class="dropdown-header">Уведомления</div>
                            <div id="notificationList" class="notification-list"></div>
                        </div>
                    </div>
                    <div class="profile-icon" id="profileIcon">
                        <i class="fas fa-user-circle"></i>
                        <div class="dropdown-menu" id="profileDropdown">
                            <div class="profile-name" id="userFullName"></div>
                            <a href="/Profile">Мой профиль</a>
                            <a href="#" id="logoutBtn">Выйти</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a asp-controller="Home" asp-action="Authorization" class="profile-icon" title="Войти / Регистрация">
                    <i class="fas fa-user-circle"></i>
                </a>
            }
        </div>
    </div>
}
<div class="page-container">
    <div class="page-header">
        <h1><i class="fas fa-images"></i> Стенды пользователей</h1>
        <p>Фотографии автомобилей, выставленных на продажу по запчастям</p>
    </div>

    <div class="users-grid" id="usersGrid"></div>
</div>

@section Scripts
{
    <script src="~/js/Market.js" asp-append-version="true"></script>
}